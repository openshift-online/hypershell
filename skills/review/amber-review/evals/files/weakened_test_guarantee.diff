 func TestGatewayPostPreservesExplicitRoute(t *testing.T) {
 	_, _ = test.RegisterIntegration(t)

 	customRoute := `{"enabled":true,"host":"custom.example.com"}`
 	gatewayService := gateways.Service(&environments.Environment().Services)
 	created, err := gatewayService.Create(context.Background(), &gateways.Gateway{
 		Name:      "route-explicit-test",
 		ClusterId: "test-cluster_id",
+		RepositoryId: stringPtr("test-repository_id"),
 		Route:     stringPtr(customRoute),
 	})
 	Expect(err).NotTo(HaveOccurred())
 	Expect(created.GetRoute()).To(Equal(customRoute))
 }
