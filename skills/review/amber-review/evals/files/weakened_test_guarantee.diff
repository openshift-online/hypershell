 func (s *sqlGatewayService) Create(ctx context.Context, gateway *Gateway) (*Gateway, *errors.ServiceError) {
+	if gateway.ClusterId == "" {
+		if s.clusterFinder == nil {
+			return nil, errors.Validation("cluster_id is required")
+		}
+		clusterID, findErr := s.clusterFinder.FindSole(ctx)
+		if findErr != nil {
+			return nil, errors.GeneralError("resolve cluster: %s", findErr)
+		}
+		if clusterID == "" {
+			return nil, errors.Validation("cluster_id is required: zero or multiple ManagedClusters exist")
+		}
+		gateway.ClusterId = clusterID
+	}
+
 	gateway.CaptureTraceContext(ctx)
 	gateway, err := s.gatewayDao.Create(ctx, gateway)
