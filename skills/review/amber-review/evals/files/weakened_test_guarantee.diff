 func (s *sqlGatewayService) Create(ctx context.Context, gateway *Gateway) (*Gateway, *errors.ServiceError) {
+	if gateway.RepositoryId == nil || *gateway.RepositoryId == "" {
+		if s.repositoryFinder == nil {
+			return nil, errors.Validation("repository_id is required")
+		}
+		repoID, findErr := s.repositoryFinder.FindSole(ctx)
+		if findErr != nil {
+			return nil, errors.GeneralError("resolve repository: %s", findErr)
+		}
+		if repoID == "" {
+			return nil, errors.Validation("repository_id is required: zero or multiple Repositories exist")
+		}
+		gateway.RepositoryId = &repoID
+	}
+
