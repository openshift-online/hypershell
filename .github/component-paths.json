{
  "api_server": {
    "directory": "components/api-server",
    "lint_job": "lint-api-server",
    "paths": [
      "components/api-server/**",
      "Makefile",
      ".github/component-paths.json",
      ".github/scripts/detect-components.sh",
      ".github/workflows/lint.yml"
    ]
  },
  "control_plane": {
    "directory": "components/control-plane",
    "lint_job": "lint-control-plane",
    "paths": [
      "components/control-plane/**",
      "components/api-server/go.mod",
      "components/api-server/go.sum",
      "components/api-server/pkg/api/grpc/**",
      "components/api-server/proto/**",
      "Makefile",
      ".github/component-paths.json",
      ".github/scripts/detect-components.sh",
      ".github/workflows/lint.yml"
    ]
  },
  "sdk_typescript": {
    "directory": "components/sdk-typescript",
    "lint_job": "lint-sdk-typescript",
    "paths": [
      "components/sdk-typescript/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "components/api-server/openapi/**",
      "components/api-server/Makefile",
      "scripts/sdk-generator/**",
      "Makefile",
      ".github/component-paths.json",
      ".github/scripts/detect-components.sh",
      ".github/workflows/lint.yml"
    ]
  },
  "gateway_ui": {
    "directory": "components/gateway-ui",
    "lint_job": "lint-gateway-ui",
    "paths": [
      "components/gateway-ui/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "Makefile",
      ".github/component-paths.json",
      ".github/scripts/detect-components.sh",
      ".github/workflows/lint.yml"
    ]
  },
  "web_console": {
    "directory": "components/web-console",
    "lint_job": "lint-web-console",
    "paths": [
      "components/web-console/**",
      "components/gateway-ui/**",
      "components/sdk-typescript/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "Makefile",
      ".github/component-paths.json",
      ".github/scripts/detect-components.sh",
      ".github/workflows/lint.yml"
    ]
  }
}
