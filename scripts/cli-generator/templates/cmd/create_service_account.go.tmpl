package serviceAccount

import (
	"bytes"
	"encoding/json"
	"fmt"
	"net/http"
	"time"

	"github.com/spf13/cobra"

	"{{.Module}}/pkg/config"
	"{{.Module}}/pkg/connection"
	"{{.Module}}/pkg/serviceaccount"
)

var args struct {
	gatewayID  string
	name       string
	description string
	role       string
	expiresAt  string
	expiresIn  string
	output     string
	outputFile string
}

var Cmd = &cobra.Command{
	Use:     "serviceAccount [flags]",
	Aliases: []string{"service-account"},
	Short:   "Create an OpenShell gateway service account",
	Long:    "Create a gateway-scoped automation identity. The client secret is returned once and is written only to the selected output.",
	Args:    cobra.NoArgs,
	RunE:    run,
}

func init() {
	flags := Cmd.Flags()
	flags.StringVar(&args.gatewayID, "gateway-id", "", "Gateway ID.")
	flags.StringVar(&args.name, "name", "", "Service-account name.")
	flags.StringVar(&args.description, "description", "", "Optional description.")
	flags.StringVar(&args.role, "role", "openshell-user", "OpenShell role: openshell-user or openshell-admin.")
	flags.StringVar(&args.expiresAt, "expires-at", "", "Absolute RFC 3339 expiration.")
	flags.StringVar(&args.expiresIn, "expires-in", "", "Relative expiration, for example 24h or 30d.")
	flags.StringVarP(&args.output, "output", "o", "json", "Structured output format (json).")
	flags.StringVar(&args.outputFile, "output-file", "", "Create a new mode-0600 file instead of writing the credential bundle to stdout. Use - for stdout.")
}

func run(cmd *cobra.Command, _ []string) error {
	if args.gatewayID == "" {
		return fmt.Errorf("--gateway-id is required")
	}
	if args.name == "" {
		return fmt.Errorf("--name is required")
	}
	if err := serviceaccount.ValidateRole(args.role); err != nil {
		return err
	}
	if err := serviceaccount.ValidateOutput(args.output); err != nil {
		return err
	}
	expiresAt, err := serviceaccount.Expiration(args.expiresAt, args.expiresIn, time.Now())
	if err != nil {
		return err
	}
	request := map[string]any{"name": args.name, "role": args.role}
	if cmd.Flags().Changed("description") {
		request["description"] = args.description
	}
	if expiresAt != "" {
		request["expires_at"] = expiresAt
	}
	body, err := json.Marshal(request)
	if err != nil {
		return fmt.Errorf("can't encode request: %w", err)
	}
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	conn, err := connection.NewConnection().Config(cfg).Build()
	if err != nil {
		return err
	}
	defer conn.Close()
	response, _, err := serviceaccount.Request(conn, http.MethodPost, serviceaccount.CollectionPath(args.gatewayID), nil, bytes.NewReader(body), http.StatusCreated)
	if err != nil {
		return fmt.Errorf("can't create service account: %w", err)
	}
	return serviceaccount.WriteStructured(cmd.OutOrStdout(), args.outputFile, response)
}
