# syntax=docker/dockerfile:1
FROM registry.access.redhat.com/hi/go:1.26.10-builder@sha256:3b4ef404a1aa7dc3a5b7034eea9ef028f84c9f7bb5413efae4d8c9a79dde31f7 AS go-toolchain

FROM openapitools/openapi-generator-cli:v7.26.0@sha256:a304ddf1e2e5f24f68fa3153568d6174cea4959d09aa8e3db6d526fd0782326d

COPY --from=go-toolchain /usr/lib/golang/bin/gofmt /usr/local/bin/gofmt

RUN mkdir -p /local
COPY . /local

ENV CGO_ENABLED=0

WORKDIR /local

RUN bash /usr/local/bin/docker-entrypoint.sh generate -i /local/openapi/openapi.yaml -g go -o /local/pkg/api/openapi
RUN rm /local/pkg/api/openapi/go.mod /local/pkg/api/openapi/go.sum
RUN rm -rf /local/pkg/api/openapi/test
RUN gofmt -w /local/pkg/api/openapi
