# syntax=docker/dockerfile:1
FROM registry.access.redhat.com/hi/go:1.26.7-builder@sha256:57229d393ce3671dc38bae0a78ae3eb59f39a9e71b2804a7f64fc368521c82cf AS go-toolchain

FROM openapitools/openapi-generator-cli:v7.16.0@sha256:e56372add5e038753fb91aa1bbb470724ef58382fdfc35082bf1b3e079ce353c

COPY --from=go-toolchain /usr/lib/golang/bin/gofmt /usr/local/bin/gofmt

RUN mkdir -p /local
COPY . /local

ENV CGO_ENABLED=0

WORKDIR /local

RUN bash /usr/local/bin/docker-entrypoint.sh generate -i /local/openapi/openapi.yaml -g go -o /local/pkg/api/openapi
RUN rm /local/pkg/api/openapi/go.mod /local/pkg/api/openapi/go.sum
RUN rm -rf /local/pkg/api/openapi/test
RUN gofmt -w /local/pkg/api/openapi
