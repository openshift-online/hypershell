# HyperShell Fullsend sandbox image.
#
# The IMAGE a Fullsend harness runs the agent in (not the runner). Extends
# Fullsend's sandbox base - which ships the security-hook binary `tirith`, pinned
# Claude Code, pi, codex, python hooks, ripgrep/fd/gitleaks - with the Go
# toolchain + make/gcc so coder and update-openshell agents can run `go build`,
# `go vet`, `go test` and `make check` inside the sandbox. Per Fullsend's design
# (fullsend-ai/fullsend images/sandbox/Containerfile), per-org sandboxes EXTEND
# fullsend-sandbox rather than replace it; a plain agent-runtime image lacks
# `tirith` and fails every Bash PreToolUse hook.
#
# Build from the repository root. Native builds: set TARGETARCH to amd64 or arm64.
ARG TARGETARCH=amd64
FROM ghcr.io/fullsend-ai/fullsend-sandbox@sha256:bcf8cd84a37623d761d38f2a6f51d20283f8798b7d3eeb9c509a2503c074bd55
USER root

# The base already provides make + the C toolchain (gcc/g++/cc/ld); HyperShell Go
# builds are CGO_ENABLED=0 (no `import "C"`), so only the Go toolchain is added.
# Go toolchain, pinned and checksum-verified (>= the repo go.mod floor, 1.26.x).
ARG TARGETARCH
ARG GO_VERSION=1.26.7
ARG GO_SHA256_amd64=ffb5f8de10c62550dfddab66b36b57030721e0a44a3218e9e1181d7b59f121ca
ARG GO_SHA256_arm64=5a4ec883379d51ee9ce1040d5e87f8d35e20387574dd8c947feb01eabc3c1b37
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) sha="${GO_SHA256_amd64}" ;; \
      arm64) sha="${GO_SHA256_arm64}" ;; \
      *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --retry-delay 5 "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tgz; \
    echo "${sha}  /tmp/go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz; \
    ln -s /usr/local/go/bin/go /usr/local/bin/go; \
    ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt; \
    /usr/local/go/bin/go version

ENV PATH="/usr/local/go/bin:/sandbox/go/bin:${PATH}" \
    GOTOOLCHAIN=local \
    GOPATH=/sandbox/go \
    GOCACHE=/sandbox/.cache/go-build

USER sandbox

ARG GIT_REVISION=unknown
ARG GIT_VERSION=development
LABEL org.opencontainers.image.title="HyperShell fullsend-sandbox" \
      org.opencontainers.image.description="Fullsend sandbox base (tirith, Claude Code, pi, codex, hooks) extended with the Go toolchain + make for in-sandbox build/test" \
      org.opencontainers.image.source="https://github.com/openshift-online/hypershell" \
      org.opencontainers.image.url="https://github.com/openshift-online/hypershell" \
      org.opencontainers.image.documentation="https://github.com/openshift-online/hypershell/tree/main/components/agents" \
      org.opencontainers.image.vendor="Red Hat, Inc." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${GIT_REVISION}" \
      org.opencontainers.image.version="${GIT_VERSION}" \
      name="hypershell/fullsend-sandbox" \
      summary="HyperShell Fullsend agent sandbox with Go/make" \
      com.redhat.component="hypershell-fullsend-sandbox" \
      distribution-scope="public" \
      io.k8s.display-name="HyperShell fullsend-sandbox" \
      io.openshift.tags="hypershell,agents,fullsend,sandbox"
