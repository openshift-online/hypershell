# Copy to .hypershell/fullsend.env (gitignored), then edit for your account.
# This is a trusted shell file. Plain assignments and export both work.
FULLSEND_SCOPE=agent/scope/YOUR_GITHUB_USERNAME/fullsend
CONCURRENCY=2
# Optional: omit to use each harness's configured model.
# FULLSEND_MODEL=YOUR_APPROVED_MODEL_ID

# Vertex: obtain the approved project and model region from your administrator.
ANTHROPIC_VERTEX_PROJECT_ID=YOUR_APPROVED_GCP_PROJECT
CLOUD_ML_REGION=YOUR_MODEL_REGION
# Create ADC first: gcloud auth application-default login
# ADC is auto-discovered from CLOUDSDK_CONFIG or ~/.config/gcloud.
# GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"

# Sign in first: acli jira auth login --web
# Jira: default auto reuses ACLI unless BOTH email and token are supplied.
# JIRA_AUTH_MODE=acli
# API-token alternative (store the real token only in the gitignored file):
# JIRA_AUTH_MODE=api-token
# JIRA_USER_EMAIL=you@example.com
# JIRA_TOKEN=YOUR_JIRA_TOKEN
# JIRA_BASE_URL=https://redhat.atlassian.net

# Gateway defaults to saved worktree selection, then OpenShell selection.
# HYPERSHELL_API_URL=https://api.hyp0.infra.hypershell.app
# OPENSHELL_GATEWAY=your-gateway
# FULLSEND_LIFECYCLE=github-only  # Explicitly disable Jira sync.
