{
  "$id": "https://fullsend.sh/schemas/code-implementation-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "code-implementation Agent Result",
  "description": "Structured output from the code-implementation agent (SDLC-HOOK-04). outcome 'completed' means the code is pushed and the PR is ready for code review; outcome 'blocked' means a hard prerequisite failed (for example no linked PR). The post-script verifies pr_number and head_sha against trusted harness input before applying any transition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "outcome",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "phase": {
      "const": "code-implementation"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "comment": {
      "type": "string",
      "maxLength": 16384
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "pr_number",
          "head_sha"
        ]
      }
    }
  ]
}
