{
  "$id": "https://fullsend.sh/schemas/update-openshell-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured output from the update-openshell agent, consumed by scripts/post-update-openshell.sh.",
  "if": {
    "properties": {
      "status": {
        "enum": [
          "findings",
          "error"
        ]
      }
    },
    "required": [
      "status"
    ]
  },
  "properties": {
    "comment": {
      "maxLength": 16384,
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "findings",
        "error"
      ],
      "type": "string"
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[^\\r\\n]*$",
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary"
  ],
  "then": {
    "properties": {
      "comment": {
        "minLength": 1
      }
    },
    "required": [
      "comment"
    ]
  },
  "title": "update-openshell Agent Result",
  "type": "object"
}
